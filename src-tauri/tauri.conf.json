{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gestión Financiera",
  "version": "2.0.0",
  "identifier": "ar.gonza.finanzas",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Gestión Financiera",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "maximized": true,
        "decorations": true,
        "backgroundColor": "#111827",
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data:"
      },
      "devCsp": {
        "default-src": "'self' asset:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:5173",
        "img-src": "'self' asset: http://asset.localhost data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "upgradeCode": "41acc6db-e3d1-5c94-8686-67183fb5f1bb"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
